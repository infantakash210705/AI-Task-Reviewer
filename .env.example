MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/shortfundly-internflow?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
NEXTAUTH_SECRET=<generate-a-random-secret>
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=<admin-email>

GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.8-flash
REVIEW_MODEL=gemini-3.8-flash
MENTOR_AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000
REVIEW_MAX_ANALYSIS_CHARS=120000
REVIEW_INTERVAL_DAYS=3

GITHUB_APP_ID=5425145
GITHUB_APP_PRIVATE_KEY_PATH=private-key.pem
GITHUB_API_BASE_URL=https://api.github.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<your-gmail-address>
SMTP_PASSWORD=<google-app-password>
EMAIL_FROM=<your-gmail-address>

GOOGLE_CALENDAR_CLIENT_ID=<calendar-oauth-client-id>
GOOGLE_CALENDAR_CLIENT_SECRET=<calendar-oauth-client-secret>
GOOGLE_CALENDAR_REFRESH_TOKEN=<organizer-oauth-refresh-token>
GOOGLE_CALENDAR_ID=primary
MEETING_MODE=internal

INNGEST_EVENT_KEY=<inngest-event-key>
INNGEST_SIGNING_KEY=<inngest-signing-key>

APP_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
EXPLANATION_DURATION_MINUTES=30
FIRST_REVIEW_DURATION_MINUTES=30
FIRST_REVIEW_INTERVAL_DAYS=3
MEETING_REMINDER_HOURS=24

# Recall.ai scheduled Google Meet mentor. Use your account's region and an HTTPS public URL.
MEETING_AGENT_PROVIDER=DISABLED
RECALL_API_KEY=<recall-api-key>
RECALL_API_BASE_URL=https://us-east-1.recall.ai
MEETING_AGENT_PUBLIC_BASE_URL=https://<your-public-domain>
MEETING_AGENT_WEBHOOK_SECRET=<recall-webhook-verification-secret-whsec>
# Signs the per-meeting realtime transcript URL given to Recall. Use 32+ random characters (openssl rand -hex 32).
MEETING_AGENT_PAGE_SECRET=<generate-at-least-32-random-characters>
MEETING_AGENT_RECORDING_ENABLED=false

# Development seed only. Set NODE_ENV=development and SEED_DEVELOPMENT_DATA=true explicitly.
SEED_DEVELOPMENT_DATA=false

# --- Mentor voice and persona (all free) ---
# Edge neural voices need no key. Set TTS_PROVIDER=browser to fall back to the browser's built-in voice only.
TTS_PROVIDER=edge
MENTOR_NAME=Arjun
# en, ta or hi. Changes the mentor's spoken language, voice and transcript language.
MENTOR_LANGUAGE=en
# Optional voice overrides (Edge neural voice names), e.g. en-IN-NeerjaNeural
MENTOR_VOICE=
MENTOR_VOICE_TA=
MENTOR_VOICE_HI=
# Optional override of the Recall transcription language code.
RECALL_TRANSCRIPT_LANGUAGE=

# --- Meetings ---
# false (default): meetings happen only when an intern requests one and the admin approves it.
AUTO_SCHEDULE_MEETINGS=false
